{
  "name": "rinnai-parts",
  "version": "0.1.0",
  "description": "MTC Gas admin — local-first Rinnai spare parts search",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ocr:vendor": "node scripts/build-ocr-sidecar.mjs",
    "build": "npm run ocr:vendor && vite build",
    "build:file": "npm run ocr:vendor && vite build --mode file",
    "preview": "vite preview",
    "ingest": "node scripts/ingest-source-data.mjs",
    "sync:tech-sheets": "node scripts/sync-tech-sheets.mjs",
    "extract:pl-covers": "node scripts/extract-pl-cover-aliases.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "vite": "^8.3.6",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "tesseract.js": "^5.1.1"
  }
}
